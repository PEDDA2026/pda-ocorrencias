# Build & Gradle caches
.gradle/
.kotlin/
**/build/
!src/**/build/

# IDE & OS files
.idea/
*.iml
.DS_Store
local.properties

# Android native & captures
captures/
.externalNativeBuild/
.cxx/

# Xcode / iOS
xcuserdata/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
